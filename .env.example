# Copy to .env (make setup does this for you). Never commit .env.

# Database name, shared by both engines
DB_NAME=olist

# Admin account, used only for creating tables and loading data
DB_ADMIN_USER=admin
DB_ADMIN_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

# Ports on your machine
POSTGRES_PORT=5432
MARIADB_PORT=3306
